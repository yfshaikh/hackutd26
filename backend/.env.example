# On-call paging (backend). The rest of the template lives in backend/README.md.
# When a defender action needs human approval, place ONE Cartesia call that reads a
# short summary to the on-call engineer. The pager agent is talk-only: nothing said
# on the call can approve or change anything. Leave PAGING_ON off to disable.
# Never commit real values; backend/.env is git-ignored.
CARTESIA_API_KEY=
CARTESIA_PAGER_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
ONCALL_PHONE=+15125551234
PAGING_ON=false
